      "checkConstraints": {
        "feeds_slug_format_check": {
          "name": "feeds_slug_format_check",
          "value": "\"feeds\".\"slug\" ~ '^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?(?:/[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?)*$'"
        },
