          "value": "char_length(\"feeds\".\"summary\") between 2 and 3000"
        },
        "feeds_source_length_check": {
          "name": "feeds_source_length_check",
          "value": "char_length(\"feeds\".\"source\") between 2 and 300"
        },
        "feeds_source_url_length_check": {
          "name": "feeds_source_url_length_check",
          "value": "char_length(\"feeds\".\"source_url\") between 8 and 4096"
        },
        "feeds_source_url_protocol_check": {
          "name": "feeds_source_url_protocol_check",
          "value": "\"feeds\".\"source_url\" ~ '^https?://[^[:space:]]+$'"
        },
        "feeds_body_length_check": {
          "name": "feeds_body_length_check",
          "value": "char_length(\"feeds\".\"body\") between 1 and 50000"
        },
        "feeds_priority_range_check": {
          "name": "feeds_priority_range_check",
          "value": "\"feeds\".\"priority\" between -1000 and 1000"
        },
        "feeds_version_positive_check": {
          "name": "feeds_version_positive_check",
          "value": "\"feeds\".\"version\" >= 1"
        },
        "feeds_content_hash_check": {
          "name": "feeds_content_hash_check",
          "value": "\"feeds\".\"content_hash\" ~ '^[0-9a-f]{64}$'"
        },
        "feeds_tags_array_check": {
          "name": "feeds_tags_array_check",
          "value": "jsonb_typeof(\"feeds\".\"tags\") = 'array'"
        },
        "feeds_lifecycle_check": {
          "name": "feeds_lifecycle_check",
          "value": "(\n        (\"feeds\".\"status\" = 'draft' and \"feeds\".\"published_at\" is null and \"feeds\".\"archived_at\" is null)\n        or (\"feeds\".\"status\" = 'published' and \"feeds\".\"published_at\" is not null and \"feeds\".\"archived_at\" is null)\n        or (\"feeds\".\"status\" = 'archived' and \"feeds\".\"published_at\" is not null and \"feeds\".\"archived_at\" is not null)\n      )"
