---
import { CATEGORIES } from '@/lib/feeds';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Feeds Hub', description = '中文资讯聚合站' } = Astro.props;
const pathname = Astro.url.pathname;
const navItems = [
  { href: '/', label: '全部' },
  ...CATEGORIES.map((category) => ({ href: `/category/${category.id}/`, label: category.shortName }))
];
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
const currentItem = navItems.find((item) => isActive(item.href)) ?? navItems[0];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0569ED" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Feeds Hub 首页">
        <img class="brand-mark" src="/images/brand/feeds-hub-logo-96.png" alt="" width="38" height="38" />
        <span><strong>Feeds Hub</strong><small>中文信息流</small></span>
      </a>
      <form class="topic-switcher" aria-label="主题选择">
        <label class="sr-only" for="topic-select">选择主题</label>
        <select id="topic-select" class="topic-select" aria-label={`当前主题：${currentItem.label}`}>
          {navItems.map((item) => (
            <option value={item.href} selected={item.href === currentItem.href}>{item.label}</option>
          ))}
        </select>
      </form>
    </header>
    <main><slot /></main>
    <footer class="site-footer">Feeds Hub · ChatGPT 自动更新</footer>
    <script>
      const topicSelect = document.querySelector<HTMLSelectElement>('#topic-select');
      topicSelect?.addEventListener('change', () => {
        if (topicSelect.value && topicSelect.value !== window.location.pathname) {
          window.location.href = topicSelect.value;
        }
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #F8FAFC;
    --panel: #ffffff;
    --surface-2: #F1F5F9;
    --surface-3: #E2E8F0;
    --text: #0F172A;
    --muted: #64748B;
    --muted-strong: #334155;
    --border: rgba(15, 23, 42, 0.10);
    --border-strong: rgba(5, 105, 237, 0.28);
    --primary: #0569ED;
    --primary-hover: #0688D1;
    --primary-strong: #034A9A;
    --signal: #069FB4;
    --signal-soft: #5CCDDC;
    --amber: #F59E0B;
    --feed-card-min-width: 480px;
    --feed-card-gap: 24px;
    --content-max-width: 960px;
    --mono: "SFMono-Regular", "Cascadia Mono", "Menlo", "Consolas", monospace;
    --shadow-card: 0 16px 34px rgba(31, 45, 65, 0.08);
    font-family: "Avenir Next", "Noto Sans CJK SC", "PingFang SC", "Microsoft YaHei", ui-sans-serif, system-ui, sans-serif;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    color: var(--text);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, .9), transparent 280px),
      linear-gradient(90deg, rgba(5, 105, 237, .07), transparent 30%, rgba(6, 159, 180, .08)),
      var(--bg);
    min-height: 100vh;
  }
  body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(rgba(15, 23, 42, 0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(15, 23, 42, 0.04) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.52), transparent 66%);
  }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; }
  main { position: relative; width: min(1800px, calc(100% - 48px)); margin: 0 auto; padding: 18px 0 56px; }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 10px max(16px, calc((100vw - 1160px) / 2));
    border-bottom: 1px solid var(--border);
    background: rgba(248, 250, 252, 0.9);
    backdrop-filter: blur(16px);
  }
  .brand { display: inline-flex; align-items: center; gap: 10px; flex: 0 0 auto; }
  .brand-mark { width: 38px; height: 38px; border-radius: 8px; object-fit: cover; box-shadow: 0 10px 22px rgba(5, 105, 237, 0.18); }
  .brand strong, .brand small { display: block; }
  .brand strong { font-size: 15px; letter-spacing: 0; }
  .brand small { color: var(--muted); font-size: 11px; margin-top: 1px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .topic-switcher { flex: 0 1 220px; margin: 0; }
  .topic-select {
    width: 100%;
    min-height: 40px;
    padding: 0 38px 0 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: #102238;
    background:
      linear-gradient(45deg, transparent 50%, #102238 50%) calc(100% - 18px) 17px / 6px 6px no-repeat,
      linear-gradient(135deg, #102238 50%, transparent 50%) calc(100% - 12px) 17px / 6px 6px no-repeat,
      rgba(255, 255, 255, .72);
    box-shadow: 0 8px 18px rgba(31, 45, 65, 0.06);
    font: inherit;
    font-size: 13px;
    font-weight: 850;
    appearance: none;
    cursor: pointer;
  }
  .topic-select:focus-visible { outline: 2px solid rgba(5, 105, 237, .34); outline-offset: 2px; }
  h1, h2, h3, p { margin-top: 0; }
  p { color: var(--muted); line-height: 1.75; }
  .feed-section { margin-top: 10px; }
  .masonry-feed {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--feed-card-min-width)), 1fr));
    gap: var(--feed-card-gap);
    width: 100%;
    align-items: stretch;
  }
  .empty-state { padding: 42px; text-align: center; background: rgba(255, 255, 255, 0.78); border-radius: 8px; border: 1px dashed var(--border); color: var(--muted); }
  .content-panel { position: relative; border: 1px solid var(--border); background: rgba(255, 255, 255, 0.82); border-radius: 8px; box-shadow: var(--shadow-card); backdrop-filter: blur(18px); }
  .site-footer { position: relative; width: min(1160px, calc(100% - 32px)); margin: 0 auto 32px; padding-top: 24px; color: var(--muted); border-top: 1px solid var(--border); font-size: 14px; }
  @media (max-width: 1100px) {
    main { width: min(100% - 32px, 960px); }
    .masonry-feed { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    main { width: min(100% - 16px, 960px); padding-top: 14px; }
    .site-header { padding: 10px 12px; }
    .brand small { display: none; }
    .topic-switcher { flex-basis: min(54vw, 190px); }
    .masonry-feed { gap: 16px; }
  }
</style>
