---
interface Props {
  title?: string;
  description?: string;
}
const { title = 'Feeds Hub', description = '中文主题信息流聚合站' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Feeds Hub 首页">
        <span class="brand-mark">F</span>
        <span><strong>Feeds Hub</strong><small>中文信息流</small></span>
      </a>
      <nav class="site-nav" aria-label="主导航">
        <a href="/">全部</a>
        <a href="/category/worldcup/">世界杯</a>
        <a href="/category/lol/">LOL</a>
        <a href="/category/stock/">股市</a>
        <a href="/category/ai/">AI 科技</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">Feeds Hub · ChatGPT 自动更新 · 中文主题信息流</footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f4f7fb;
    --panel: #ffffff;
    --panel-soft: rgba(255, 255, 255, 0.78);
    --text: #111827;
    --muted: #64748b;
    --muted-strong: #334155;
    --border: rgba(15, 23, 42, 0.1);
    --border-strong: rgba(37, 99, 235, 0.24);
    --primary: #2563eb;
    --primary-strong: #1d4ed8;
    --cyan: #38bdf8;
    --shadow: 0 20px 60px rgba(15, 23, 42, 0.08);
    --shadow-card: 0 14px 38px rgba(15, 23, 42, 0.075);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    color: var(--text);
    background:
      radial-gradient(circle at 12% 0%, rgba(37, 99, 235, 0.14), transparent 32rem),
      radial-gradient(circle at 92% 8%, rgba(56, 189, 248, 0.16), transparent 28rem),
      linear-gradient(180deg, #f8fbff 0%, var(--bg) 46%, #f8fafc 100%);
    min-height: 100vh;
  }
  body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(rgba(15, 23, 42, 0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(15, 23, 42, 0.035) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.75), transparent 62%);
  }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; }
  main { position: relative; width: min(1180px, calc(100% - 32px)); margin: 0 auto; padding: 34px 0 60px; }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 14px max(16px, calc((100vw - 1180px) / 2));
    border-bottom: 1px solid var(--border);
    background: rgba(248, 251, 255, 0.82);
    backdrop-filter: blur(18px);
  }
  .brand { display: inline-flex; align-items: center; gap: 12px; }
  .brand-mark {
    width: 42px;
    height: 42px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    color: #fff;
    font-weight: 950;
    background: linear-gradient(135deg, var(--primary), var(--cyan));
    box-shadow: 0 12px 26px rgba(37, 99, 235, 0.24);
  }
  .brand strong, .brand small { display: block; }
  .brand strong { letter-spacing: -0.02em; }
  .brand small { color: var(--muted); font-size: 12px; margin-top: 2px; }
  .site-nav { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
  .site-nav a, .pill-link {
    padding: 8px 12px;
    border-radius: 999px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 700;
  }
  .site-nav a:hover, .pill-link:hover { color: var(--primary-strong); background: rgba(37, 99, 235, 0.08); }
  h1 { font-size: clamp(38px, 7vw, 72px); line-height: 1.02; letter-spacing: -0.06em; margin: 0 0 18px; }
  h2 { font-size: clamp(24px, 4vw, 38px); line-height: 1.1; letter-spacing: -0.04em; margin: 0 0 10px; }
  h3, p { margin-top: 0; }
  p { color: var(--muted); line-height: 1.75; }
  .hero { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr); gap: 20px; margin-bottom: 18px; }
  .hero-panel, .summary-panel, .content-panel {
    position: relative;
    border: 1px solid var(--border);
    background: var(--panel-soft);
    border-radius: 30px;
    box-shadow: var(--shadow);
    backdrop-filter: blur(18px);
  }
  .hero-panel { overflow: hidden; padding: clamp(28px, 5vw, 56px); }
  .hero-panel::after {
    content: "";
    position: absolute;
    right: -88px;
    bottom: -96px;
    width: 260px;
    height: 260px;
    border-radius: 70px;
    transform: rotate(18deg);
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.1), rgba(56, 189, 248, 0.18));
  }
  .hero-panel > * { position: relative; z-index: 1; }
  .summary-panel { display: grid; align-content: space-between; gap: 20px; padding: 24px; }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 8px 12px;
    color: var(--primary-strong);
    background: rgba(37, 99, 235, 0.1);
    border-radius: 999px;
    font-size: 14px;
    font-weight: 900;
    margin-bottom: 16px;
  }
  .summary-number { display: block; font-size: 52px; line-height: 1; font-weight: 950; color: var(--primary); margin-bottom: 8px; letter-spacing: -0.05em; }
  .summary-label { display: block; font-weight: 900; margin-bottom: 8px; }
  .category-list, .feed-grid { display: grid; gap: 16px; }
  .category-list { grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 18px 0 30px; }
  .category-card {
    min-height: 148px;
    padding: 18px;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid var(--border);
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.05);
    transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
  }
  .category-card:hover { transform: translateY(-3px); border-color: var(--border-strong); box-shadow: var(--shadow-card); }
  .category-card strong { display: block; margin-bottom: 8px; font-size: 18px; letter-spacing: -0.02em; }
  .category-card span { color: var(--muted); line-height: 1.65; font-size: 14px; }
  .feed-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: stretch; }
  .section-head { display: flex; align-items: end; justify-content: space-between; gap: 16px; margin: 22px 0 16px; }
  .section-head p { margin-bottom: 0; }
  .empty-state {
    padding: 42px;
    text-align: center;
    background: rgba(255, 255, 255, 0.78);
    border-radius: 26px;
    border: 1px dashed var(--border);
    color: var(--muted);
  }
  .site-footer { position: relative; width: min(1180px, calc(100% - 32px)); margin: 0 auto 32px; padding-top: 24px; color: var(--muted); border-top: 1px solid var(--border); font-size: 14px; }
  @media (max-width: 920px) {
    .site-header { align-items: flex-start; flex-direction: column; }
    .site-nav { justify-content: flex-start; }
    .hero, .category-list, .feed-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    main { width: min(100% - 24px, 1180px); padding-top: 22px; }
    .site-header { padding: 14px 12px; }
    .hero, .category-list, .feed-grid { grid-template-columns: 1fr; }
    .summary-panel { min-height: 180px; }
    .section-head { align-items: flex-start; flex-direction: column; }
  }
</style>
