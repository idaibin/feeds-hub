---
import { CATEGORIES } from '@/lib/feeds';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Feeds Hub', description = '中文资讯聚合站' } = Astro.props;
const pathname = Astro.url.pathname;
const navItems = [
  { href: '/', label: '全部' },
  ...CATEGORIES.map((category) => ({ href: `/category/${category.id}/`, label: category.shortName }))
];
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
const currentItem = navItems.find((item) => isActive(item.href)) ?? navItems[0];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Feeds Hub 首页">
        <span class="brand-mark">F</span>
        <span><strong>Feeds Hub</strong><small>中文信息流</small></span>
      </a>
      <form class="topic-switcher" aria-label="主题选择">
        <label class="sr-only" for="topic-select">选择主题</label>
        <select id="topic-select" class="topic-select" aria-label={`当前主题：${currentItem.label}`}>
          {navItems.map((item) => (
            <option value={item.href} selected={item.href === currentItem.href}>{item.label}</option>
          ))}
        </select>
      </form>
    </header>
    <main><slot /></main>
    <footer class="site-footer">Feeds Hub · ChatGPT 自动更新</footer>
    <script>
      const topicSelect = document.querySelector<HTMLSelectElement>('#topic-select');
      topicSelect?.addEventListener('change', () => {
        if (topicSelect.value && topicSelect.value !== window.location.pathname) {
          window.location.href = topicSelect.value;
        }
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #eef3f8;
    --panel: #ffffff;
    --text: #101827;
    --muted: #66758a;
    --muted-strong: #2f3d52;
    --border: rgba(29, 43, 67, 0.12);
    --border-strong: rgba(20, 95, 160, 0.32);
    --primary: #145fa0;
    --primary-strong: #0b4d84;
    --signal: #0e9888;
    --amber: #b7791f;
    --mono: "SFMono-Regular", "Cascadia Mono", "Menlo", "Consolas", monospace;
    --shadow-card: 0 16px 34px rgba(31, 45, 65, 0.08);
    font-family: "Avenir Next", "Noto Sans CJK SC", "PingFang SC", "Microsoft YaHei", ui-sans-serif, system-ui, sans-serif;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    color: var(--text);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, .9), transparent 280px),
      linear-gradient(90deg, rgba(20, 95, 160, .08), transparent 28%, rgba(14, 152, 136, .08)),
      var(--bg);
    min-height: 100vh;
  }
  body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(rgba(29, 43, 67, 0.045) 1px, transparent 1px), linear-gradient(90deg, rgba(29, 43, 67, 0.045) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.52), transparent 66%);
  }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; }
  main { position: relative; width: min(1160px, calc(100% - 32px)); margin: 0 auto; padding: 18px 0 56px; }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 10px max(16px, calc((100vw - 1160px) / 2));
    border-bottom: 1px solid var(--border);
    background: rgba(244, 248, 252, 0.9);
    backdrop-filter: blur(16px);
  }
  .brand { display: inline-flex; align-items: center; gap: 10px; flex: 0 0 auto; }
  .brand-mark { width: 38px; height: 38px; border-radius: 8px; display: grid; place-items: center; color: #fff; font-weight: 950; background: linear-gradient(135deg, var(--primary), var(--signal)); box-shadow: 0 10px 22px rgba(20, 95, 160, 0.18); }
  .brand strong, .brand small { display: block; }
  .brand strong { font-size: 15px; letter-spacing: 0; }
  .brand small { color: var(--muted); font-size: 11px; margin-top: 1px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .topic-switcher { flex: 0 1 220px; margin: 0; }
  .topic-select {
    width: 100%;
    min-height: 40px;
    padding: 0 38px 0 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: #102238;
    background:
      linear-gradient(45deg, transparent 50%, #102238 50%) calc(100% - 18px) 17px / 6px 6px no-repeat,
      linear-gradient(135deg, #102238 50%, transparent 50%) calc(100% - 12px) 17px / 6px 6px no-repeat,
      rgba(255, 255, 255, .72);
    box-shadow: 0 8px 18px rgba(31, 45, 65, 0.06);
    font: inherit;
    font-size: 13px;
    font-weight: 850;
    appearance: none;
    cursor: pointer;
  }
  .topic-select:focus-visible { outline: 2px solid rgba(20, 95, 160, .34); outline-offset: 2px; }
  h1, h2, h3, p { margin-top: 0; }
  p { color: var(--muted); line-height: 1.75; }
  .feed-section { margin-top: 10px; }
  .masonry-feed { column-count: 3; column-gap: 14px; }
  .empty-state { padding: 42px; text-align: center; background: rgba(255, 255, 255, 0.78); border-radius: 8px; border: 1px dashed var(--border); color: var(--muted); }
  .content-panel { position: relative; border: 1px solid var(--border); background: rgba(255, 255, 255, 0.82); border-radius: 8px; box-shadow: var(--shadow-card); backdrop-filter: blur(18px); }
  .site-footer { position: relative; width: min(1160px, calc(100% - 32px)); margin: 0 auto 32px; padding-top: 24px; color: var(--muted); border-top: 1px solid var(--border); font-size: 14px; }
  @media (max-width: 920px) {
    .site-header { align-items: center; }
    .topic-switcher { flex-basis: min(48vw, 220px); }
    .masonry-feed { column-count: 2; }
  }
  @media (max-width: 640px) {
    main { width: min(100% - 16px, 1160px); padding-top: 14px; }
    .site-header { padding: 10px 12px; }
    .brand small { display: none; }
    .topic-switcher { flex-basis: min(54vw, 190px); }
    .masonry-feed { column-count: 1; column-gap: 0; }
  }
</style>
