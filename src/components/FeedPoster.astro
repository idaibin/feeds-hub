---
import type { CollectionEntry } from 'astro:content';
import { getCategoryMeta } from '@/lib/feeds';

interface Props {
  entry: CollectionEntry<'feeds'>;
  variant?: 'card' | 'detail';
}

const { entry, variant = 'card' } = Astro.props;
const category = getCategoryMeta(entry.data.category);
const tags = entry.data.tags ?? [];
const kind = entry.data.kind;
const kindNameMap: Record<string, string> = {
  match_result: '战报',
  match_schedule: '赛程',
  hot_topic: '热点',
  market_brief: '简报',
  policy_update: '政策'
};
const kindName = kindNameMap[kind] ?? '热点';
const scoreSource = `${entry.data.title} ${entry.data.topic}`;
const scoreMatch = scoreSource.match(/(\d+)\s*[-:：]\s*(\d+)/);
const scoreText = scoreMatch ? `${scoreMatch[1]} - ${scoreMatch[2]}` : '';
const rawScore = scoreMatch?.[0] ?? '';
const isResult = kind === 'match_result' && Boolean(scoreText);
const isSchedule = kind === 'match_schedule';
const posterTitle = isResult
  ? scoreText
  : isSchedule
    ? entry.data.topic
    : entry.data.topic || entry.data.title;
const posterSubtitle = isResult
  ? (entry.data.topic.includes(rawScore) ? entry.data.topic.replace(rawScore, '').trim() : entry.data.title.replace(/\d+\s*[-:：]\s*\d+/, '').replace(/[，,:：。].*$/, '').trim())
  : isSchedule
    ? 'VS · 时间 · 阶段'
    : entry.data.subtitle;
---

<div class={`feed-poster category-${entry.data.category} kind-${kind} variant-${variant}`} aria-label={`${entry.data.title} 海报`}>
  <div class="poster-pattern" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="poster-top"><span>{category.shortName} · {kindName}</span></div>
  <div class="poster-main">
    {isResult ? (
      <div class="score-mode">
        <strong>{posterTitle}</strong>
        <p>{posterSubtitle || '全场结束'}</p>
        <em>全场结束</em>
      </div>
    ) : isSchedule ? (
      <div class="schedule-mode">
        <strong>{posterTitle}</strong>
        <p>{posterSubtitle}</p>
      </div>
    ) : (
      <div class="feature-mode">
        <strong>{posterTitle}</strong>
        <p>{posterSubtitle}</p>
      </div>
    )}
  </div>
  <div class="poster-tags">
    {tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
  </div>
</div>

<style>
  .feed-poster {
    --accent: #4f46e5;
    --accent-2: #8b5cf6;
    --bg-a: #111827;
    --bg-b: #312e81;
    position: relative;
    display: flex;
    min-height: 0;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: inherit;
    color: #fff;
    isolation: isolate;
    background:
      radial-gradient(circle at 72% 24%, rgba(255,255,255,.22), transparent 24%),
      linear-gradient(145deg, var(--bg-a), var(--bg-b));
  }
  .variant-detail { aspect-ratio: 4 / 5; min-height: min(760px, 78vh); }
  .category-worldcup { --accent: #22c55e; --accent-2: #86efac; --bg-a: #062d22; --bg-b: #0f7a4f; }
  .category-lol { --accent: #7c3aed; --accent-2: #c4b5fd; --bg-a: #130b2f; --bg-b: #5b21b6; }
  .category-stock { --accent: #0891b2; --accent-2: #67e8f9; --bg-a: #082f49; --bg-b: #155e75; }
  .category-ai { --accent: #4f46e5; --accent-2: #a5b4fc; --bg-a: #11124a; --bg-b: #4338ca; }
  .category-global { --accent: #2563eb; --accent-2: #93c5fd; --bg-a: #172033; --bg-b: #334155; }
  .category-rust { --accent: #b45309; --accent-2: #fdba74; --bg-a: #2b1707; --bg-b: #92400e; }
  .category-product { --accent: #db2777; --accent-2: #f9a8d4; --bg-a: #2a0a1d; --bg-b: #9d174d; }

  .feed-poster::before,
  .feed-poster::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .feed-poster::before {
    background:
      linear-gradient(to bottom, rgba(0,0,0,.08), rgba(0,0,0,.4)),
      repeating-linear-gradient(90deg, rgba(255,255,255,.035) 0 1px, transparent 1px 52px),
      repeating-linear-gradient(0deg, rgba(255,255,255,.03) 0 1px, transparent 1px 52px);
    mix-blend-mode: screen;
  }
  .feed-poster::after {
    background: linear-gradient(to bottom, transparent 38%, rgba(0,0,0,.64) 100%);
  }
  .category-worldcup::before {
    background:
      radial-gradient(ellipse at 50% 86%, rgba(255,255,255,.22) 0 2px, transparent 3px),
      radial-gradient(circle at 76% 65%, rgba(255,255,255,.7) 0 34px, rgba(0,0,0,.3) 35px 36px, transparent 37px),
      linear-gradient(18deg, transparent 56%, rgba(255,255,255,.14) 57%, transparent 58%),
      linear-gradient(-18deg, transparent 56%, rgba(255,255,255,.14) 57%, transparent 58%);
  }
  .category-lol::before {
    background:
      radial-gradient(circle at 50% 42%, rgba(255,210,118,.45) 0 56px, transparent 58px),
      linear-gradient(64deg, transparent 18%, rgba(196,181,253,.22) 19%, transparent 25%),
      linear-gradient(-64deg, transparent 18%, rgba(196,181,253,.22) 19%, transparent 25%);
  }
  .category-stock::before {
    background:
      linear-gradient(160deg, transparent 24%, rgba(103,232,249,.18) 25%, rgba(103,232,249,.18) 27%, transparent 28%),
      repeating-linear-gradient(90deg, rgba(255,255,255,.05) 0 1px, transparent 1px 58px),
      repeating-linear-gradient(0deg, rgba(255,255,255,.045) 0 1px, transparent 1px 58px);
  }
  .category-ai::before {
    background:
      radial-gradient(circle at 64% 34%, transparent 0 42px, rgba(165,180,252,.28) 44px 48px, transparent 50px),
      radial-gradient(circle at 52% 38%, transparent 0 38px, rgba(255,255,255,.22) 40px 43px, transparent 45px),
      repeating-linear-gradient(90deg, rgba(255,255,255,.045) 0 1px, transparent 1px 42px);
  }

  .poster-pattern span { position: absolute; border-radius: 999px; background: rgba(255,255,255,.08); filter: blur(18px); }
  .poster-pattern span:nth-child(1) { width: 220px; height: 220px; right: -60px; top: 96px; }
  .poster-pattern span:nth-child(2) { width: 190px; height: 190px; left: -70px; bottom: 120px; }
  .poster-pattern span:nth-child(3) { width: 120px; height: 120px; right: 110px; bottom: 210px; background: color-mix(in srgb, var(--accent) 45%, transparent); }
  .poster-top { position: absolute; top: clamp(14px, 4%, 24px); right: clamp(14px, 4%, 24px); z-index: 2; }
  .poster-top span {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 16px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 78%, #020617 22%);
    box-shadow: 0 10px 28px rgba(0,0,0,.2);
    font-size: clamp(13px, 2.6vw, 18px);
    font-weight: 900;
    white-space: nowrap;
  }
  .poster-main {
    position: absolute;
    left: clamp(24px, 7%, 52px);
    right: clamp(24px, 7%, 52px);
    bottom: clamp(92px, 15%, 132px);
    z-index: 2;
  }
  .poster-main strong {
    display: block;
    max-width: 92%;
    font-size: clamp(34px, 8.4vw, 76px);
    line-height: 1.08;
    letter-spacing: -.05em;
    text-wrap: balance;
    text-shadow: 0 16px 36px rgba(0,0,0,.28);
  }
  .score-mode strong { font-size: clamp(64px, 17vw, 150px); letter-spacing: -.03em; }
  .schedule-mode strong { max-width: 96%; }
  .poster-main p {
    max-width: 96%;
    margin: 14px 0 0;
    color: rgba(255,255,255,.86);
    font-size: clamp(16px, 3.4vw, 28px);
    line-height: 1.35;
    font-weight: 800;
    text-shadow: 0 12px 26px rgba(0,0,0,.26);
  }
  .score-mode em {
    display: inline-flex;
    margin-top: 18px;
    padding: 7px 13px;
    border: 1px solid rgba(255,255,255,.22);
    border-radius: 999px;
    background: rgba(0,0,0,.22);
    color: var(--accent-2);
    font-style: normal;
    font-size: clamp(13px, 2.8vw, 20px);
    font-weight: 900;
  }
  .poster-tags {
    position: absolute;
    left: clamp(24px, 7%, 52px);
    right: clamp(24px, 7%, 52px);
    bottom: clamp(24px, 6%, 44px);
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .poster-tags span {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    max-width: 100%;
    padding: 0 13px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.18);
    border-radius: 999px;
    background: rgba(255,255,255,.12);
    color: rgba(255,255,255,.88);
    font-size: clamp(12px, 2.5vw, 16px);
    font-weight: 850;
    white-space: nowrap;
    text-overflow: ellipsis;
    backdrop-filter: blur(14px);
  }
</style>
