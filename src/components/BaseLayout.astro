---
import "@/styles.css";
import { PRIMARY_FEED_NAV } from "@/lib/feeds";

interface Props {
    title?: string;
    description?: string;
    hideFooter?: boolean;
}

const {
    title = "Feeds Hub",
    description = "中文资讯聚合站",
    hideFooter = false,
} = Astro.props;
const pathname = Astro.url.pathname;
const feedCategoryId = pathname.startsWith("/feed/")
    ? pathname.split("/")[2]
    : undefined;
const categoryPathId = pathname.startsWith("/category/")
    ? pathname.split("/")[2]
    : undefined;
const getNavHrefByCategory = (categoryId: string) => {
    if (categoryId === "compute") return "/category/ai/";
    if (categoryId === "rust") return "/category/dev/";
    return `/category/${categoryId}/`;
};
const activeHref = feedCategoryId
    ? getNavHrefByCategory(feedCategoryId)
    : categoryPathId
      ? getNavHrefByCategory(categoryPathId)
      : pathname;
const isActive = (href: string) =>
    href === "/" ? activeHref === "/" : activeHref === href;
const currentItem =
    PRIMARY_FEED_NAV.find((item) => isActive(item.href)) ?? PRIMARY_FEED_NAV[0];
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon-16x16.png"
        />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <meta name="theme-color" content="#0569ED" />
        <title>{title}</title>
    </head>
    <body>
        <header class="site-header">
            <a class="brand" href="/" aria-label="Feeds Hub 首页">
                <img
                    class="brand-mark"
                    src="/images/brand/feeds-hub-logo-96.png"
                    alt=""
                    width="38"
                    height="38"
                />
                <span
                    ><strong>Feeds Hub</strong><small>AI · 信息流自动生成</small
                    ></span
                >
            </a>
            <details class="topic-switcher">
                <summary aria-label={`当前主题：${currentItem.label}`}>
                    <span>{currentItem.label}</span>
                    <svg aria-hidden="true" viewBox="0 0 16 16">
                        <path d="M4 6l4 4 4-4" />
                    </svg>
                </summary>
                <nav class="topic-menu" aria-label="主题选择">
                    {
                        PRIMARY_FEED_NAV.map((item) => (
                            <a
                                class:list={["topic-option", { active: item.href === currentItem.href }]}
                                href={item.href}
                                aria-current={item.href === currentItem.href ? "page" : undefined}
                            >
                                {item.label}
                            </a>
                        ))
                    }
                </nav>
            </details>
        </header>
        <main class="flex-1"><slot /></main>
        {
            !hideFooter && (
                <footer class="relative mx-auto mb-4 flex w-[min(820px,calc(100%_-_32px))] items-center justify-between gap-4 border-t border-slate-900/10 pt-3 text-[13px] text-slate-500 max-[640px]:w-[min(820px,calc(100%_-_16px))] max-[640px]:gap-2 max-[640px]:text-xs">
                    <span class="inline-flex min-w-0 items-baseline gap-2 whitespace-nowrap leading-tight max-[640px]:gap-1">
                        <strong class="font-normal text-slate-500">
                            © 2026 Feeds Hub
                        </strong>
                        <small class="text-xs font-normal text-slate-400">
                            All rights reserved.
                        </small>
                    </span>
                    <nav
                        class="flex shrink-0 items-center justify-end gap-2"
                        aria-label="站点链接"
                    >
                        <a
                            class="inline-flex items-center gap-1.5 whitespace-nowrap text-slate-500 no-underline hover:text-feed-primary-strong"
                            href="https://github.com/idaibin/feeds-hub"
                            target="_blank"
                            rel="noreferrer"
                        >
                            <span>GitHub</span>
                            <svg
                                class="h-3.5 w-3.5 shrink-0 fill-none stroke-current stroke-[1.8] [stroke-linecap:round] [stroke-linejoin:round]"
                                aria-hidden="true"
                                viewBox="0 0 24 24"
                            >
                                <path d="M7 17L17 7" />
                                <path d="M9 7h8v8" />
                            </svg>
                        </a>
                    </nav>
                </footer>
            )
        }
    </body>
</html>

<style is:global>
    :root {
        --bg: #f8fafc;
        --panel: #ffffff;
        --surface-2: #f1f5f9;
        --surface-3: #e2e8f0;
        --text: #0f172a;
        --muted: #64748b;
        --muted-strong: #334155;
        --border: rgba(15, 23, 42, 0.1);
        --border-strong: rgba(5, 105, 237, 0.28);
        --primary: #0569ed;
        --primary-hover: #0688d1;
        --primary-strong: #034a9a;
        --signal: #069fb4;
        --signal-soft: #5ccddc;
        --amber: #f59e0b;
        --feed-card-min-width: 480px;
        --feed-card-gap: 16px;
        --feed-card-row-gap: 16px;
        --content-max-width: 960px;
        --mono:
            "SFMono-Regular", "Cascadia Mono", "Menlo", "Consolas", monospace;
        --shadow-card: 0 16px 34px rgba(31, 45, 65, 0.08);
        font-family:
            "Avenir Next", "Noto Sans CJK SC", "PingFang SC", "Microsoft YaHei",
            ui-sans-serif, system-ui, sans-serif;
    }
    .category-worldcup {
        --topic-accent: #0569ed;
        --topic-bg: rgba(5, 105, 237, 0.06);
        --topic-border: rgba(5, 105, 237, 0.18);
    }
    .category-lol {
        --topic-accent: #b45309;
        --topic-bg: rgba(180, 83, 9, 0.07);
        --topic-border: rgba(180, 83, 9, 0.2);
    }
    .category-stock {
        --topic-accent: #0a7e90;
        --topic-bg: rgba(6, 159, 180, 0.07);
        --topic-border: rgba(6, 159, 180, 0.22);
    }
    .category-ai {
        --topic-accent: #0688d1;
        --topic-bg: rgba(6, 136, 209, 0.07);
        --topic-border: rgba(6, 136, 209, 0.2);
    }
    .category-github {
        --topic-accent: #1f883d;
        --topic-bg: rgba(31, 136, 61, 0.07);
        --topic-border: rgba(31, 136, 61, 0.2);
    }
    .category-compute {
        --topic-accent: #0891b2;
        --topic-bg: rgba(8, 145, 178, 0.07);
        --topic-border: rgba(8, 145, 178, 0.2);
    }
    .category-global {
        --topic-accent: #64748b;
        --topic-bg: rgba(100, 116, 139, 0.07);
        --topic-border: rgba(100, 116, 139, 0.18);
    }
    .category-rust {
        --topic-accent: #b45309;
        --topic-bg: rgba(180, 83, 9, 0.07);
        --topic-border: rgba(180, 83, 9, 0.2);
    }
    .category-dev {
        --topic-accent: #2563eb;
        --topic-bg: rgba(37, 99, 235, 0.07);
        --topic-border: rgba(37, 99, 235, 0.2);
    }
    .category-security {
        --topic-accent: #475569;
        --topic-bg: rgba(71, 85, 105, 0.08);
        --topic-border: rgba(71, 85, 105, 0.2);
    }
    .category-product {
        --topic-accent: #0a7e90;
        --topic-bg: rgba(10, 126, 144, 0.07);
        --topic-border: rgba(10, 126, 144, 0.2);
    }
    * {
        box-sizing: border-box;
    }
    body {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100vh;
        min-height: 100vh;
        overflow-x: hidden;
        margin: 0;
        color: var(--text);
        background:
            linear-gradient(
                180deg,
                rgba(255, 255, 255, 0.9),
                transparent 280px
            ),
            linear-gradient(
                90deg,
                rgba(5, 105, 237, 0.07),
                transparent 30%,
                rgba(6, 159, 180, 0.08)
            ),
            var(--bg);
    }
    body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background-image:
            linear-gradient(rgba(15, 23, 42, 0.04) 1px, transparent 1px),
            linear-gradient(90deg, rgba(15, 23, 42, 0.04) 1px, transparent 1px);
        background-size: 44px 44px;
        mask-image: linear-gradient(
            180deg,
            rgba(0, 0, 0, 0.52),
            transparent 66%
        );
    }
    a {
        color: inherit;
        text-decoration: none;
    }
    img {
        display: block;
        max-width: 100%;
    }
    main {
        flex: 1 1 auto;
        display: flex;
        align-items: stretch;
        justify-content: center;
        position: relative;
        width: 100%;
        min-height: 0;
        margin: 0 auto;
        overflow-x: hidden;
        overflow-y: auto;
        padding-block: 16px;
        padding-inline: 16px;
        scrollbar-color: rgba(100, 116, 139, 0.36) transparent;
        scrollbar-gutter: stable;
        scrollbar-width: thin;
    }
    main::-webkit-scrollbar {
        width: 6px;
    }
    main::-webkit-scrollbar-track {
        background: transparent;
    }
    main::-webkit-scrollbar-thumb {
        border-radius: 999px;
        background: rgba(100, 116, 139, 0.32);
    }
    main::-webkit-scrollbar-thumb:hover {
        background: rgba(100, 116, 139, 0.5);
    }
    .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding-block: 10px;
        padding-inline: max(16px, calc(50vw - 580px));
        border-bottom: 1px solid var(--border);
        background: rgba(248, 250, 252, 0.9);
        backdrop-filter: blur(16px);
    }
    .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        flex: 0 0 auto;
    }
    .brand-mark {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        object-fit: cover;
        box-shadow: 0 10px 22px rgba(5, 105, 237, 0.18);
    }
    .brand strong,
    .brand small {
        display: block;
    }
    .brand strong {
        color: transparent;
        background: linear-gradient(90deg, #0569ed, #0f8b8d, #069fb4, #0569ed);
        background-size: 240% 100%;
        background-clip: text;
        -webkit-background-clip: text;
        animation: brand-title-flow 12s linear infinite;
        font-size: 15px;
        letter-spacing: 0;
    }
    .brand small {
        color: var(--muted);
        font-size: 11px;
        margin-top: 1px;
    }
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding-block: 0;
        padding-inline: 0;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }
    .topic-switcher {
        position: relative;
        flex: 0 0 auto;
        margin: 0;
    }
    .topic-switcher summary {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        min-width: 132px;
        min-height: 36px;
        padding-block: 0;
        padding-inline: 14px 12px;
        border: 1px solid rgba(15, 23, 42, 0.1);
        border-radius: 8px;
        color: #102238;
        background: linear-gradient(180deg, rgba(255,255,255,.96), rgba(248,250,252,.86));
        box-shadow:
            inset 0 1px 0 rgba(255,255,255,.9),
            0 10px 22px rgba(31, 45, 65, 0.07);
        font-size: 12px;
        font-weight: 760;
        line-height: 1;
        list-style: none;
        cursor: pointer;
        user-select: none;
    }
    .topic-switcher summary::-webkit-details-marker {
        display: none;
    }
    .topic-switcher summary:hover {
        border-color: rgba(5, 105, 237, 0.2);
        background: #fff;
    }
    .topic-switcher summary:focus-visible {
        border-color: rgba(5, 105, 237, 0.3);
        outline: 2px solid rgba(5, 105, 237, 0.18);
        outline-offset: 2px;
    }
    .topic-switcher summary svg {
        width: 14px;
        height: 14px;
        flex: 0 0 auto;
        stroke: #334155;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
        fill: none;
        transition: transform .16s ease;
    }
    .topic-switcher[open] summary svg {
        transform: rotate(180deg);
    }
    .topic-menu {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        z-index: 30;
        display: grid;
        min-width: 156px;
        max-height: min(420px, calc(100vh - 84px));
        padding: 6px;
        border: 1px solid rgba(15, 23, 42, 0.1);
        border-radius: 10px;
        background: rgba(255,255,255,.96);
        box-shadow:
            0 18px 44px rgba(31, 45, 65, 0.14),
            0 1px 0 rgba(255,255,255,.9) inset;
        backdrop-filter: blur(18px);
        overflow-y: auto;
        scrollbar-color: rgba(100, 116, 139, 0.34) transparent;
        scrollbar-width: thin;
    }
    .topic-menu::-webkit-scrollbar {
        width: 5px;
    }
    .topic-menu::-webkit-scrollbar-track {
        background: transparent;
    }
    .topic-menu::-webkit-scrollbar-thumb {
        border-radius: 999px;
        background: rgba(100, 116, 139, 0.3);
    }
    .topic-option {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 32px;
        padding-block: 0;
        padding-inline: 12px;
        border-radius: 7px;
        color: #475569;
        font-size: 12px;
        font-weight: 720;
        line-height: 1;
        white-space: nowrap;
    }
    .topic-option:hover {
        color: #0f172a;
        background: rgba(15, 23, 42, 0.04);
    }
    .topic-option.active {
        color: var(--primary-strong);
        background: linear-gradient(90deg, rgba(5,105,237,.1), rgba(6,159,180,.08));
    }
    .topic-option.active::after {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 999px;
        background: currentColor;
        opacity: .86;
    }
    h1,
    h2,
    h3,
    p {
        margin-top: 0;
    }
    p {
        color: var(--muted);
        line-height: 1.75;
    }
    .feed-section {
        margin-top: 10px;
    }
    .masonry-feed {
        column-width: var(--feed-card-min-width);
        column-gap: var(--feed-card-gap);
        width: 100%;
    }
    .masonry-feed > .feed-card {
        display: inline-block;
        width: 100%;
        margin: 0 0 var(--feed-card-row-gap);
        break-inside: avoid;
        -webkit-column-break-inside: avoid;
    }
    .masonry-feed > .feed-card[hidden] {
        display: none;
    }
    .feed-load-sentinel {
        width: 100%;
        height: 1px;
    }
    .feed-end-state {
        width: 100%;
        margin: 8px 0 0;
        color: #8a99aa;
        font-size: 12px;
        line-height: 1.5;
        text-align: center;
    }
    .empty-state {
        padding-block: 42px;
        padding-inline: 42px;
        text-align: center;
        background: rgba(255, 255, 255, 0.78);
        border-radius: 8px;
        border: 1px dashed var(--border);
        color: var(--muted);
    }
    .content-panel {
        position: relative;
        border: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.82);
        border-radius: 8px;
        box-shadow: var(--shadow-card);
        backdrop-filter: blur(18px);
    }

    @keyframes brand-title-flow {
        0% {
            background-position: 0% 50%;
        }
        100% {
            background-position: 240% 50%;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .brand strong {
            animation: none;
            background-position: 0 50%;
        }
    }
</style>
