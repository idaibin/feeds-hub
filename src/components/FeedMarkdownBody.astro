---
import { isRedundantDisplayText, stripSourceMentions } from '@/lib/feed-display';

interface Props {
  body?: string;
  source?: string;
  title?: string;
  subtitle?: string;
  summary?: string;
  class?: string;
}

const { body = '', source, title = '', subtitle = '', summary = '', class: className } = Astro.props;
const referenceTexts = [title, subtitle, summary].filter(Boolean);

type MarkdownBlock =
  | { type: 'heading'; level: 2 | 3; text: string }
  | { type: 'list'; items: string[] }
  | { type: 'callout'; label: string; text: string }
  | { type: 'paragraph'; text: string };

function escapeHtml(value: string) {
  return value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function renderInline(value: string) {
  return escapeHtml(value)
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
}

function clean(value: string) {
  return stripSourceMentions(value, source);
}

function isRedundant(value: string) {
  return referenceTexts.some((reference) => isRedundantDisplayText(value, reference));
}

function parseCallout(value: string) {
  const match = /^(重要提示|提示词|提示|注意)[：:]\s*(.+)$/.exec(value);
  if (!match) return undefined;
  return { label: match[1], text: match[2].trim() };
}

function parseMarkdown(value: string) {
  const blocks: MarkdownBlock[] = [];
  let paragraphLines: string[] = [];
  let listItems: string[] = [];

  const flushParagraph = () => {
    const text = clean(paragraphLines.join(' '));
    paragraphLines = [];
    if (text && !isRedundant(text)) {
      blocks.push({ type: 'paragraph', text });
    }
  };

  const flushList = () => {
    const items = listItems
      .map((item) => clean(item))
      .filter((item) => item && !isRedundant(item));
    listItems = [];
    if (items.length) {
      blocks.push({ type: 'list', items });
    }
  };

  for (const rawLine of value.split(/\r?\n/)) {
    const line = rawLine.trim();

    if (!line) {
      flushParagraph();
      flushList();
      continue;
    }

    const heading = /^(#{2,3})\s+(.+)$/.exec(line);
    if (heading) {
      flushParagraph();
      flushList();
      const text = clean(heading[2]);
      if (text && !isRedundant(text)) {
        blocks.push({ type: 'heading', level: heading[1].length as 2 | 3, text });
      }
      continue;
    }

    const listItem = /^[-*]\s+(.+)$/.exec(line);
    if (listItem) {
      flushParagraph();
      listItems.push(listItem[1]);
      continue;
    }

    flushList();
    const callout = parseCallout(clean(line));
    if (callout) {
      flushParagraph();
      if (callout.text && !isRedundant(callout.text)) {
        blocks.push({ type: 'callout', label: callout.label, text: callout.text });
      }
      continue;
    }

    paragraphLines.push(line);
  }

  flushParagraph();
  flushList();

  return blocks;
}

function getFallbackBlocks() {
  const blocks: MarkdownBlock[] = [];
  const fallbackReferences = [title].filter(Boolean);

  for (const value of [subtitle, summary]) {
    const text = clean(value);
    const isDuplicate = fallbackReferences.some((reference) => isRedundantDisplayText(text, reference));

    if (text && !isDuplicate) {
      blocks.push({ type: 'paragraph', text });
      fallbackReferences.push(text);
    }
  }

  return blocks;
}

const parsedBlocks = parseMarkdown(body);
const blocks = parsedBlocks.length ? parsedBlocks : getFallbackBlocks();
---

<div class={className}>
  {
    blocks.map((block) => {
      if (block.type === 'heading') {
        return block.level === 2
          ? <h2 set:html={renderInline(block.text)}></h2>
          : <h3 set:html={renderInline(block.text)}></h3>;
      }

      if (block.type === 'list') {
        return <ul>{block.items.map((item) => <li set:html={renderInline(item)} />)}</ul>;
      }

      if (block.type === 'callout') {
        return (
          <p class="detail-callout">
            <span class="detail-callout-label">{block.label}</span>
            <span set:html={renderInline(block.text)} />
          </p>
        );
      }

      return <p set:html={renderInline(block.text)} />;
    })
  }
</div>
