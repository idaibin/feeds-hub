---
import type { CollectionEntry } from 'astro:content';
import { formatDate, getCategoryMeta } from '@/lib/feeds';
import { getDisplaySummary, getDisplayTitle } from '@/lib/feed-display';

interface Props {
  entry: CollectionEntry<'feeds'>;
}
const { entry } = Astro.props;
const category = getCategoryMeta(entry.data.category);
const href = `/feed/${entry.id}/`;
const title = getDisplayTitle(entry.data.title, entry.data.source);
const summary = getDisplaySummary(entry.data.summary, title, entry.data.source);
---
<article class:list={['feed-card', `category-${entry.data.category}`]} data-feed-card>
  <a class="card-link" href={href} aria-label={title}>
    <div class="feed-body">
      <div class="feed-meta">
        <span class="category-chip">{category.shortName}</span>
        <time datetime={entry.data.eventAt.toISOString()}>{formatDate(entry.data.eventAt)}</time>
      </div>
      <h2>{title}</h2>
      {summary && <p class="summary">{summary}</p>}
    </div>
  </a>
</article>

<style is:global>
  .feed-card {
    --accent: var(--primary);
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 8px;
    background: rgba(255, 255, 255, .96);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease, background .18s ease;
  }

  .feed-card:hover {
    transform: translateY(-2px);
    border-color: rgba(5, 105, 237, .18);
    background: #fff;
    box-shadow: 0 16px 34px rgba(15, 23, 42, .10);
  }

  .feed-card.category-worldcup {
    --accent: var(--primary);
  }

  .feed-card.category-lol {
    --accent: #7c3aed;
  }

  .feed-card.category-stock {
    --accent: var(--signal);
  }

  .feed-card.category-ai {
    --accent: #0569ed;
  }

  .feed-card.category-compute {
    --accent: #0891b2;
  }

  .feed-card.category-global {
    --accent: #0f8b8d;
  }

  .feed-card.category-rust {
    --accent: #b45309;
  }

  .feed-card.category-dev {
    --accent: #2563eb;
  }

  .feed-card.category-security {
    --accent: #475569;
  }

  .feed-card.category-product {
    --accent: #db2777;
  }

  .feed-card .card-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
    min-height: 0;
    padding: 12px;
    color: inherit;
    text-decoration: none;
  }

  .feed-card .feed-body {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: flex-start;
  }

  .feed-card .category-chip {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    max-width: 120px;
    overflow: hidden;
    padding: 0;
    color: var(--accent);
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .feed-card .category-chip::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 7px;
    border-radius: 999px;
    background: currentColor;
    vertical-align: 1px;
  }

  .feed-card .feed-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-width: 0;
    width: 100%;
    margin-bottom: 8px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
  }

  .feed-card .feed-meta time {
    flex: 0 0 auto;
    margin-left: auto;
    font-family: var(--mono);
    font-size: 11px;
    text-align: right;
    white-space: nowrap;
  }

  .feed-card h2 {
    margin: 0 0 8px;
    overflow: hidden;
    color: #0f172a;
    font-size: 20px;
    line-height: 1.36;
    letter-spacing: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .feed-card h2:last-child {
    margin-bottom: 0;
  }

  .feed-card .summary {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
  }

  .feed-card .summary {
    margin: 0;
    color: var(--muted);
    line-height: 1.68;
    font-size: 14px;
    -webkit-line-clamp: 3;
  }

  @media (max-width: 640px) {
    .feed-card .card-link {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
      padding: 12px;
    }

    .feed-card h2 { font-size: 18px; }
    .feed-card .summary { font-size: 14px; -webkit-line-clamp: 3; }
    .feed-card .feed-meta { gap: 6px 8px; }
  }
</style>
