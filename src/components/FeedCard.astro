---
import type { CollectionEntry } from 'astro:content';
import { formatDate, getCategoryMeta } from '@/lib/feeds';

interface Props { entry: CollectionEntry<'feeds'>; }
const { entry } = Astro.props;
const category = getCategoryMeta(entry.data.category);
const href = `/feed/${entry.id}/`;
---
<article class="feed-card">
  <a class="banner-link" href={href}>
    <img src={entry.data.cover} alt={entry.data.title} loading="lazy" />
  </a>
  <div class="feed-body">
    <div class="meta-row">
      <span>{category.shortName}</span>
      <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
    </div>
    <h2><a href={href}>{entry.data.title}</a></h2>
    <p class="subtitle">{entry.data.subtitle}</p>
    <p class="summary">{entry.data.summary}</p>
  </div>
</article>

<style>
  .feed-card { display: inline-block; width: 100%; margin: 0 0 18px; break-inside: avoid; border: 1px solid var(--border); border-radius: 22px; background: rgba(255,255,255,.9); box-shadow: var(--shadow-card); transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .feed-card:hover { transform: translateY(-3px); border-color: var(--border-strong); box-shadow: 0 20px 46px rgba(15,23,42,.12); }
  .banner-link { display: block; aspect-ratio: 16 / 9; background: linear-gradient(135deg, #eef4ff, #f8fafc); border-radius: 22px 22px 0 0; }
  .banner-link img { width: 100%; height: 100%; object-fit: cover; border-radius: 22px 22px 0 0; transition: transform .22s ease; }
  .feed-card:hover .banner-link img { transform: scale(1.025); }
  .feed-body { padding: 16px; }
  .meta-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; color: var(--muted); font-size: 12px; }
  .meta-row span { min-width: 0; color: var(--primary-strong); font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
  .meta-row time { flex: 0 0 auto; }
  h2 { margin: 0 0 8px; font-size: 20px; line-height: 1.35; letter-spacing: -.03em; }
  .subtitle { margin: 0 0 10px; color: var(--muted-strong); line-height: 1.55; font-weight: 800; }
  .summary { margin: 0; color: var(--muted); line-height: 1.75; font-size: 14px; }
  @media (max-width: 640px) { .feed-card { margin-bottom: 14px; border-radius: 18px; } .feed-body { padding: 14px; } h2 { font-size: 19px; } }
</style>
