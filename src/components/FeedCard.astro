---
import type { CollectionEntry } from 'astro:content';
import { formatDate, getCategoryMeta } from '@/lib/feeds';

interface Props { entry: CollectionEntry<'feeds'>; }
const { entry } = Astro.props;
const category = getCategoryMeta(entry.data.category);
const href = `/feed/${entry.id}/`;
const fallbackCover = entry.data.fallbackCover ?? `/images/${entry.data.category}/init.webp`;
const posterRatioClass = getPosterRatioClass(entry.data.category, entry.data.kind);

function getPosterRatioClass(categoryId: string, kind: string) {
  const isMatchCategory = categoryId === 'worldcup' || categoryId === 'lol';

  if (isMatchCategory && ['match_result', 'match_schedule', 'player_spotlight'].includes(kind)) {
    return 'poster-ratio-4x5';
  }

  if (['ai', 'product'].includes(categoryId) && kind === 'visual') {
    return 'poster-ratio-4x5';
  }

  if (isMatchCategory && kind === 'visual') {
    return 'poster-ratio-4x5';
  }

  if (['match_flow', 'knockout_update', 'worldcup_feed', 'data'].includes(kind)) {
    return 'poster-ratio-4x3';
  }

  return 'poster-ratio-16x9';
}
---
<article class={`feed-card category-${entry.data.category} ${posterRatioClass}`} data-feed-card>
  <a class="card-link" href={href} aria-label={entry.data.title}>
    <div class="poster-shell">
      <img src={entry.data.cover} alt="" loading="lazy" data-cover-image onerror={`this.onerror=null;this.src='${fallbackCover}';`} />
    </div>
    <div class="feed-body">
      <div class="meta-row">
        <span>{category.shortName}</span>
        <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
      </div>
      <h2>{entry.data.title}</h2>
      <p class="summary">{entry.data.summary}</p>
    </div>
  </a>
</article>

<style>
  .feed-card {
    --accent: var(--primary);
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 22px;
    background: rgba(255, 255, 255, .96);
    box-shadow: 0 18px 44px rgba(15, 23, 42, 0.08);
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }

  .feed-card:hover {
    transform: translateY(-3px);
    border-color: rgba(5, 105, 237, .18);
    box-shadow: 0 24px 56px rgba(15, 23, 42, .14);
  }

  .category-worldcup,
  .category-lol,
  .category-ai,
  .category-global {
    --accent: var(--primary);
  }

  .category-stock,
  .category-rust,
  .category-product {
    --accent: var(--signal);
  }

  .card-link {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .poster-shell {
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: 22px 22px 0 0;
    overflow: hidden;
    background: #0f172a;
  }

  .poster-ratio-4x5 .poster-shell {
    aspect-ratio: 4 / 5;
  }

  .poster-ratio-4x3 .poster-shell {
    aspect-ratio: 4 / 3;
  }

  .poster-shell img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feed-body {
    display: flex;
    min-height: 176px;
    flex: 1;
    flex-direction: column;
    padding: 16px 18px 19px;
  }

  .meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
    color: var(--muted);
    font-size: 12px;
  }

  .meta-row span {
    min-width: 0;
    color: var(--accent);
    font-weight: 950;
    letter-spacing: .01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .meta-row span::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    border-radius: 999px;
    background: currentColor;
    vertical-align: 1px;
  }

  .meta-row time {
    flex: 0 0 auto;
    font-family: var(--mono);
    font-size: 10.5px;
    color: #748196;
  }

  h2 {
    display: -webkit-box;
    margin: 0 0 8px;
    overflow: hidden;
    color: #0f172a;
    font-size: 18px;
    line-height: 1.38;
    letter-spacing: -.01em;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .summary {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
  }

  .summary {
    margin: 0;
    color: var(--muted);
    line-height: 1.62;
    font-size: 13.5px;
    -webkit-line-clamp: 2;
  }

  @media (max-width: 640px) {
    .feed-card { border-radius: 24px; }
    .poster-shell { border-radius: 24px 24px 0 0; }
    .feed-body { min-height: 170px; padding: 16px 16px 19px; }
    h2 { font-size: 18px; }
    .summary { font-size: 14px; -webkit-line-clamp: 2; }
  }
</style>
