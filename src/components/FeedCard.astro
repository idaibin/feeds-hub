---
import type { CollectionEntry } from 'astro:content';
import { formatDate, getCategoryMeta } from '@/lib/feeds';

interface Props { entry: CollectionEntry<'feeds'>; }
const { entry } = Astro.props;
const category = getCategoryMeta(entry.data.category);
---
<a class="feed-card" href={`/feed/${entry.slug}/`}>
  <div class="cover-wrap"><img src={entry.data.cover} alt={`${entry.data.title}海报`} loading="lazy" /></div>
  <div class="feed-body">
    <div class="meta-row"><span>{category.shortName}</span><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time></div>
    <h3>{entry.data.title}</h3>
    <p>{entry.data.subtitle}</p>
    <div class="tag-row">{entry.data.tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}</div>
  </div>
</a>

<style>
  .feed-card { display: flex; flex-direction: column; min-height: 100%; border: 1px solid var(--border); border-radius: 26px; overflow: hidden; background: var(--panel); box-shadow: 0 12px 32px rgba(15,23,42,.06); transition: transform .18s ease, box-shadow .18s ease; }
  .feed-card:hover { transform: translateY(-4px); box-shadow: 0 18px 42px rgba(15,23,42,.11); }
  .cover-wrap { aspect-ratio: 16 / 9; background: #eef4ff; overflow: hidden; }
  .cover-wrap img { width: 100%; height: 100%; object-fit: cover; }
  .feed-body { display: flex; flex: 1; flex-direction: column; gap: 12px; padding: 18px; }
  .meta-row { display: flex; justify-content: space-between; gap: 12px; color: var(--muted); font-size: 13px; }
  .meta-row span { color: #1d4ed8; font-weight: 800; }
  h3 { margin: 0; font-size: 20px; line-height: 1.35; letter-spacing: -.02em; }
  p { margin: 0; color: var(--muted); line-height: 1.6; }
  .tag-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; }
  .tag-row span { padding: 6px 9px; border-radius: 999px; color: #334155; background: #f1f5f9; font-size: 12px; }
</style>
