---
import FeedMarkdownBody from '@/components/FeedMarkdownBody.astro';
import type { Feed } from '@/domain/feed';
import { getDisplaySubtitle, getDisplaySummary, getDisplayTitle } from '@/lib/feed-display';
import { formatDate, getCategoryMeta } from '@/lib/feeds';

interface Props {
  feed: Feed;
  mode?: 'list' | 'detail';
}

const { feed, mode = 'list' } = Astro.props;
const isDetail = mode === 'detail';
const category = getCategoryMeta(feed.category);
const href = `/feed/${feed.slug}/`;
const title = getDisplayTitle(feed.title, feed.source);
const subtitle = isDetail ? getDisplaySubtitle(feed.subtitle, feed.source, [title]) : '';
const summary = getDisplaySummary(
  feed.summary,
  title,
  feed.source,
  subtitle ? [subtitle] : []
);
const detailNote = isDetail ? [subtitle, summary].filter(Boolean).join('；') : '';
---
<article class:list={['feed-card', `category-${feed.category}`, { 'is-detail': isDetail }]} data-feed-card>
  {
    isDetail ? (
      <div class="card-link detail-frame">
        <div class="feed-body">
          <div class="feed-meta">
            <a class="category-chip" href={`/category/${category.id}/`}>{category.shortName}</a>
            <time datetime={feed.eventAt.toISOString()}>{formatDate(feed.eventAt)}</time>
          </div>
          <h1>{title}</h1>
          {detailNote && (
            <p class="detail-note">
              {detailNote}
            </p>
          )}
          <FeedMarkdownBody
            class="markdown-body"
            body={feed.body}
            source={feed.source}
            title={title}
            subtitle={subtitle}
            summary={summary}
          />
        </div>
      </div>
    ) : (
      <a class="card-link" href={href} aria-label={title}>
        <div class="feed-body">
          <div class="feed-meta">
            <span class="category-chip">{category.shortName}</span>
            <time datetime={feed.eventAt.toISOString()}>{formatDate(feed.eventAt)}</time>
          </div>
          <h2>{title}</h2>
          {summary && <p class="summary">{summary}</p>}
        </div>
      </a>
    )
  }
</article>

<style is:global>
  .feed-card {
    --accent: var(--topic-accent, var(--primary));
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--topic-border, rgba(15, 23, 42, 0.08));
    border-radius: 8px;
    background: linear-gradient(180deg, rgba(255, 255, 255, .98), rgba(255, 255, 255, .94)), var(--topic-bg, transparent);
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.055);
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease, background .18s ease;
  }

  .feed-card:hover {
    transform: translateY(-2px);
    border-color: rgba(5, 105, 237, .18);
    background: #fff;
    box-shadow: 0 12px 28px rgba(15, 23, 42, .09);
  }

  .feed-card.is-detail {
    max-width: 760px;
    margin-inline: auto;
    align-self: flex-start;
  }

  .feed-card.is-detail:hover {
    transform: none;
    border-color: var(--topic-border, rgba(15, 23, 42, 0.08));
    background: linear-gradient(180deg, rgba(255, 255, 255, .98), rgba(255, 255, 255, .94)), var(--topic-bg, transparent);
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.055);
  }

  .feed-card .card-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
    min-height: 0;
    padding: 11px;
    color: inherit;
    text-decoration: none;
  }

  .feed-card.is-detail .card-link {
    padding: 12px;
  }

  .feed-card .feed-body {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: flex-start;
  }

  .feed-card .category-chip {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    max-width: 120px;
    overflow: hidden;
    padding: 0;
    color: var(--accent);
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0;
    line-height: 1.4;
    text-overflow: ellipsis;
    text-decoration: none;
    white-space: nowrap;
  }

  .feed-card .category-chip::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 7px;
    border-radius: 999px;
    background: currentColor;
    vertical-align: 1px;
  }

  .feed-card .category-chip[href]:hover {
    color: var(--primary-active);
  }

  .feed-card .feed-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-width: 0;
    width: 100%;
    margin-bottom: 8px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
  }

  .feed-card .feed-meta time {
    flex: 0 0 auto;
    margin-left: auto;
    font-family: var(--mono);
    font-size: 11px;
    text-align: right;
    white-space: nowrap;
  }

  .feed-card h2 {
    margin: 0 0 8px;
    overflow: hidden;
    color: #0f172a;
    font-size: 20px;
    line-height: 1.36;
    letter-spacing: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .feed-card h1 {
    margin: 0 0 10px;
    color: #0f172a;
    font-size: clamp(26px, 4.2vw, 38px);
    font-weight: 900;
    line-height: 1.12;
    letter-spacing: 0;
  }

  .feed-card h2:last-child {
    margin-bottom: 0;
  }

  .feed-card .summary {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    margin: 0;
    color: var(--muted);
    line-height: 1.68;
    font-size: 14px;
    -webkit-line-clamp: 3;
  }

  .feed-card.is-detail .category-chip {
    max-width: 180px;
    font-size: 16px;
    line-height: 1.25;
  }

  .feed-card.is-detail .category-chip::before {
    width: 8px;
    height: 8px;
  }

  .feed-card.is-detail .detail-note {
    margin: 0 0 10px;
    overflow: visible;
    border: 1px solid var(--topic-border, rgba(15, 23, 42, 0.08));
    border-radius: 8px;
    background: color-mix(in srgb, var(--topic-bg, rgba(5, 105, 237, 0.06)) 72%, #fff);
    padding-block: 8px;
    padding-inline: 12px;
    color: #334155;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.65;
    -webkit-line-clamp: unset;
  }

  .feed-card.is-detail .detail-callout-label {
    display: inline-flex;
    align-items: center;
    min-height: 22px;
    border-radius: 999px;
    background: var(--topic-accent, var(--primary));
    padding-inline: 8px;
    color: #fff;
    font-size: 12px;
    font-weight: 850;
    line-height: 1;
    white-space: nowrap;
  }

  .feed-card.is-detail .markdown-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: #334155;
    font-size: clamp(16px, 2.3vw, 22px);
    line-height: 1.8;
  }

  .feed-card.is-detail .markdown-body p,
  .feed-card.is-detail .markdown-body h2,
  .feed-card.is-detail .markdown-body h3,
  .feed-card.is-detail .markdown-body ul {
    margin: 0;
  }

  .feed-card.is-detail .markdown-body .detail-callout {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 8px;
    border: 1px solid var(--topic-border, rgba(15, 23, 42, 0.08));
    border-radius: 8px;
    background: color-mix(in srgb, var(--topic-bg, rgba(5, 105, 237, 0.06)) 70%, #fff);
    padding-block: 8px;
    padding-inline: 10px;
  }

  .feed-card.is-detail .markdown-body h2 {
    padding-top: 8px;
    color: #0f172a;
    font-size: 22px;
    font-weight: 800;
    line-height: 1.2;
  }

  .feed-card.is-detail .markdown-body h3 {
    padding-top: 4px;
    color: #0f172a;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.25;
  }

  .feed-card.is-detail .markdown-body ul {
    padding-left: 20px;
  }

  .feed-card.is-detail .markdown-body li {
    margin-block: 4px;
  }

  .feed-card.is-detail .markdown-body a {
    color: var(--primary-active);
    text-decoration: none;
  }

  .feed-card.is-detail .markdown-body code {
    border-radius: 6px;
    background: #f1f5f9;
    padding: 2px 4px;
    font-family: var(--mono);
    font-size: .92em;
  }

  .feed-card.is-detail .markdown-body strong {
    font-weight: 800;
  }

  @media (max-width: 640px) {
    .feed-card .card-link {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
      padding: 9px;
    }

    .feed-card h2 { font-size: 18px; }
    .feed-card h1 { font-size: 26px; }
    .feed-card .summary { font-size: 14px; -webkit-line-clamp: 3; }
    .feed-card.is-detail .card-link { padding: 10px; }
    .feed-card.is-detail .detail-note { font-size: 15px; }
    .feed-card.is-detail .category-chip { font-size: 16px; }
    .feed-card .feed-meta { gap: 5px 8px; margin-bottom: 6px; }
  }
</style>
