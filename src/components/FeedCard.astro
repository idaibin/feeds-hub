---
import type { CollectionEntry } from 'astro:content';
import { formatDate, getCategoryMeta } from '@/lib/feeds';

interface Props { entry: CollectionEntry<'feeds'>; }
const { entry } = Astro.props;
const category = getCategoryMeta(entry.data.category);
const href = `/feed/${entry.id}/`;
const fallbackCover = entry.data.fallbackCover ?? `/images/${entry.data.category}/init.webp`;
---
<article class={`feed-card category-${entry.data.category}`}>
  <a class="card-link" href={href} aria-label={entry.data.title}>
    <div class="poster-shell">
      <img src={entry.data.cover} alt="" loading="lazy" onerror={`this.onerror=null;this.src='${fallbackCover}';`} />
    </div>
    <div class="feed-body">
      <div class="meta-row">
        <span>{category.shortName}</span>
        <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
      </div>
      <h2>{entry.data.title}</h2>
      <p class="subtitle">{entry.data.subtitle}</p>
      <p class="summary">{entry.data.summary}</p>
    </div>
  </a>
</article>

<style>
  .feed-card {
    --accent: var(--primary);
    position: relative;
    display: inline-block;
    width: 100%;
    margin: 0 0 18px;
    break-inside: avoid;
    overflow: hidden;
    border: 1px solid rgba(29, 43, 67, 0.1);
    border-radius: 22px;
    background: rgba(255, 255, 255, .96);
    box-shadow: 0 18px 44px rgba(15, 23, 42, 0.08);
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }
  .feed-card:hover { transform: translateY(-3px); border-color: rgba(29,43,67,.18); box-shadow: 0 24px 56px rgba(15,23,42,.14); }
  .category-worldcup { --accent: #16a34a; }
  .category-lol { --accent: #6d5dfc; }
  .category-stock { --accent: #0e7490; }
  .category-ai { --accent: #4f46e5; }
  .category-global { --accent: #2563eb; }
  .category-rust { --accent: #b45309; }
  .category-product { --accent: #db2777; }
  .card-link { display: block; color: inherit; text-decoration: none; }
  .poster-shell {
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: 22px 22px 0 0;
    overflow: hidden;
    background: #0f172a;
  }
  .poster-shell img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .feed-body { padding: 15px 17px 17px; }
  .meta-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; color: var(--muted); font-size: 12px; }
  .meta-row span { min-width: 0; color: var(--accent); font-weight: 950; letter-spacing: .01em; text-overflow: ellipsis; white-space: nowrap; }
  .meta-row span::before { content: ''; display: inline-block; width: 8px; height: 8px; margin-right: 8px; border-radius: 999px; background: currentColor; vertical-align: 1px; }
  .meta-row time { flex: 0 0 auto; font-family: var(--mono); font-size: 10.5px; color: #748196; }
  h2 {
    display: -webkit-box;
    margin: 0 0 8px;
    overflow: hidden;
    color: #0f172a;
    font-size: 17px;
    line-height: 1.38;
    letter-spacing: -.01em;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .subtitle,
  .summary {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
  }
  .subtitle { margin: 0 0 8px; color: var(--muted-strong); font-size: 13.5px; line-height: 1.5; font-weight: 760; -webkit-line-clamp: 1; }
  .summary { margin: 0; color: var(--muted); line-height: 1.66; font-size: 13px; -webkit-line-clamp: 2; }
  @media (max-width: 640px) {
    .feed-card { margin-bottom: 16px; border-radius: 24px; }
    .poster-shell { border-radius: 24px 24px 0 0; }
    .feed-body { padding: 16px 16px 18px; }
    h2 { font-size: 18px; }
    .subtitle { font-size: 14.5px; }
    .summary { font-size: 14px; -webkit-line-clamp: 1; }
  }
</style>
