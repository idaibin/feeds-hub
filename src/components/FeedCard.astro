---
import type { CollectionEntry } from 'astro:content';
import { getCategoryMeta } from '@/lib/feeds';

interface Props { entry: CollectionEntry<'feeds'>; }
const { entry } = Astro.props;
const category = getCategoryMeta(entry.data.category);
const href = `/feed/${entry.id}/`;
const fallbackCover = entry.data.fallbackCover ?? `/images/${entry.data.category}/init.webp`;
---
<article class={`feed-card category-${entry.data.category}`} data-feed-card>
  <a class="card-link" href={href} aria-label={entry.data.title}>
    <div class="poster-shell">
      <img src={entry.data.cover} alt="" loading="lazy" data-cover-image onerror={`this.onerror=null;this.src='${fallbackCover}';`} />
    </div>
    <div class="feed-body">
      <span class="category-chip">{category.shortName}</span>
      <h2>{entry.data.title}</h2>
      <p class="summary">{entry.data.summary}</p>
    </div>
  </a>
</article>

<style>
  .feed-card {
    --accent: var(--primary);
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 22px;
    background: rgba(255, 255, 255, .96);
    box-shadow: 0 18px 44px rgba(15, 23, 42, 0.08);
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }

  .feed-card:hover {
    transform: translateY(-3px);
    border-color: rgba(5, 105, 237, .18);
    box-shadow: 0 24px 56px rgba(15, 23, 42, .14);
  }

  .category-worldcup,
  .category-lol,
  .category-ai,
  .category-global {
    --accent: var(--primary);
  }

  .category-stock,
  .category-rust,
  .category-product {
    --accent: var(--signal);
  }

  .card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .poster-shell {
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: 22px 22px 0 0;
    overflow: hidden;
    background: #0f172a;
  }

  .poster-shell img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .feed-body {
    position: relative;
    padding: 15px 18px 18px;
  }

  .category-chip {
    position: absolute;
    top: 15px;
    right: 18px;
    max-width: 38%;
    overflow: hidden;
    color: var(--accent);
    font-size: 12px;
    font-weight: 950;
    letter-spacing: .01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .category-chip::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    border-radius: 999px;
    background: currentColor;
    vertical-align: 1px;
  }

  h2 {
    display: -webkit-box;
    margin: 0 0 8px;
    padding-right: min(42%, 132px);
    overflow: hidden;
    color: #0f172a;
    font-size: 18px;
    line-height: 1.38;
    letter-spacing: -.01em;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .summary {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
  }

  .summary {
    margin: 0;
    color: var(--muted);
    line-height: 1.62;
    font-size: 13.5px;
    -webkit-line-clamp: 2;
  }

  @media (max-width: 640px) {
    .feed-card { border-radius: 24px; }
    .poster-shell { border-radius: 24px 24px 0 0; }
    .feed-body { padding: 16px 16px 19px; }
    .category-chip {
      top: 16px;
      right: 16px;
      max-width: 36%;
      font-size: 12px;
    }
    h2 { font-size: 18px; }
    .summary { font-size: 14px; -webkit-line-clamp: 2; }
  }
</style>
