---
import type { CollectionEntry } from 'astro:content';
import { getCategoryMeta } from '@/lib/feeds';

interface Props {
  entry: CollectionEntry<'feeds'>;
}
const { entry } = Astro.props;
const category = getCategoryMeta(entry.data.category);
const href = `/feed/${entry.id}/`;
const fallbackCover = entry.data.fallbackCover ?? `/images/${entry.data.category}/init.webp`;
---
<article class={`feed-card category-${entry.data.category}`} data-feed-card>
  <a class="card-link" href={href} aria-label={entry.data.title}>
    <div class="poster-shell">
      <img src={entry.data.cover} alt="" loading="lazy" data-cover-image onerror={`this.onerror=null;this.src='${fallbackCover}';`} />
      <span class="category-chip">{category.shortName}</span>
    </div>
    <div class="feed-body">
      <h2>{entry.data.title}</h2>
      <p class="summary">{entry.data.summary}</p>
    </div>
  </a>
</article>

<style is:global>
  .feed-card {
    --accent: var(--primary);
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 22px;
    background: rgba(255, 255, 255, .96);
    box-shadow: 0 18px 44px rgba(15, 23, 42, 0.08);
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }

  .feed-card:hover {
    transform: translateY(-3px);
    border-color: rgba(5, 105, 237, .18);
    box-shadow: 0 24px 56px rgba(15, 23, 42, .14);
  }

  .feed-card.category-worldcup {
    --accent: var(--primary);
  }

  .feed-card.category-lol {
    --accent: #7c3aed;
  }

  .feed-card.category-stock {
    --accent: var(--signal);
  }

  .feed-card.category-ai {
    --accent: #0569ed;
  }

  .feed-card.category-compute {
    --accent: #0891b2;
  }

  .feed-card.category-global {
    --accent: #0f8b8d;
  }

  .feed-card.category-rust {
    --accent: #b45309;
  }

  .feed-card.category-dev {
    --accent: #2563eb;
  }

  .feed-card.category-security {
    --accent: #475569;
  }

  .feed-card.category-product {
    --accent: #db2777;
  }

  .feed-card .card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .feed-card .poster-shell {
    display: block;
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 22px 22px 0 0;
    overflow: hidden;
    background: #0f172a;
  }

  .feed-card .poster-shell img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .feed-card .feed-body {
    padding: 15px 18px 18px;
  }

  .feed-card .category-chip {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    max-width: calc(100% - 24px);
    overflow: hidden;
    border-radius: 999px;
    padding: 6px 10px;
    color: var(--accent);
    background: rgba(0, 0, 0, .8);
    font-size: 12px;
    font-weight: 950;
    letter-spacing: 0;
    line-height: 1.2;
    text-shadow: 0 1px 8px rgba(0, 0, 0, .5);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .feed-card .category-chip::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 7px;
    border-radius: 999px;
    background: currentColor;
    vertical-align: 1px;
  }

  .feed-card h2 {
    margin: 0 0 8px;
    overflow: hidden;
    color: #0f172a;
    font-size: 18px;
    line-height: 1.38;
    letter-spacing: -.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .feed-card .summary {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
  }

  .feed-card .summary {
    margin: 0;
    color: var(--muted);
    line-height: 1.62;
    font-size: 13.5px;
    -webkit-line-clamp: 2;
  }

  @media (max-width: 640px) {
    .feed-card { border-radius: 24px; }
    .feed-card .poster-shell { border-radius: 24px 24px 0 0; }
    .feed-card .feed-body { padding: 16px 16px 19px; }
    .feed-card .category-chip {
      top: 12px;
      right: 12px;
      max-width: calc(100% - 24px);
      font-size: 12px;
    }
    .feed-card h2 { font-size: 18px; }
    .feed-card .summary { font-size: 14px; -webkit-line-clamp: 2; }
  }
</style>
