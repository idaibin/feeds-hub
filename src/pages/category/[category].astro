---
import FeedList from '@/components/FeedList.astro';
import BaseLayout from '@/components/BaseLayout.astro';
import { CATEGORIES, FEED_GROUPS, getAllFeeds, getFeedGroupMeta, getFeedTopicMeta, getFeedsByList } from '@/lib/feeds';

export function getStaticPaths() {
  return [...CATEGORIES, ...FEED_GROUPS].map((category) => ({ params: { category: category.id }, props: { category } }));
}

const { category } = Astro.props;
const allFeeds = await getAllFeeds();
const feeds = getFeedsByList(allFeeds, category.id);
const topic = getFeedTopicMeta(category.id);
const group = getFeedGroupMeta(category.id);
const listLabel = topic?.name ?? group?.name ?? category.name;
const listDescription = topic?.description ?? group?.description ?? category.description;
---
<BaseLayout title={`${listLabel}｜Feeds Hub`} description={listDescription} hideFooter>
  <FeedList entries={feeds} ariaLabel={`${listLabel}信息`} listId={category.id} />
</BaseLayout>
