---
import FeedCard from '@/components/FeedCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CATEGORIES, getAllFeeds } from '@/lib/feeds';

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { category: category.id }, props: { category } }));
}

const { category } = Astro.props;
const feeds = (await getAllFeeds()).filter((entry) => entry.data.category === category.id);
---
<BaseLayout title={`${category.name}｜Feeds Hub`} description={category.description}>
  <section class="hero-panel" style="margin-bottom: 28px;">
    <span class="eyebrow">主题分类</span>
    <h1>{category.name}</h1>
    <p>{category.description}</p>
    <a class="pill-link" href="/">返回全部信息流</a>
  </section>
  <section>
    <div class="section-head"><div><h2>{category.name}最新内容</h2><p>仅展示通过基础审查的内容。</p></div></div>
    {feeds.length > 0 ? <div class="feed-grid">{feeds.map((entry) => <FeedCard entry={entry} />)}</div> : <div class="empty-state">该分类暂无已审查内容。</div>}
  </section>
</BaseLayout>
