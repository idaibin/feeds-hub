---
import FeedList from '@/components/FeedList.astro';
import BaseLayout from '@/components/BaseLayout.astro';
import { getFeedSource } from '@/lib/feed-sources';
import { getFeedListMeta } from '@/lib/feeds';

export const prerender = false;

const listId = Astro.params.category ?? '';
const listMeta = getFeedListMeta(listId);
if (!listMeta) return new Response(null, { status: 404, statusText: 'Not found' });
const page = await (await getFeedSource()).listPublished({ list: listId, page: 1, pageSize: 10 });
const listLabel = listMeta.name;
const listDescription = listMeta.description;
---
<BaseLayout title={`${listLabel}｜Feeds Hub`} description={listDescription} hideFooter>
  <FeedList entries={page.items} ariaLabel={`${listLabel}信息`} listId={listId} hasMore={page.hasMore} />
</BaseLayout>
