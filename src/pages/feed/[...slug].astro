---
import { getCollection } from "astro:content";
import BaseLayout from "@/components/BaseLayout.astro";
import FeedMarkdownBody from "@/components/FeedMarkdownBody.astro";
import {
    getDisplaySubtitle,
    getDisplaySummary,
    getDisplayTitle,
} from "@/lib/feed-display";
import { formatDate, getCategoryMeta } from "@/lib/feeds";
import {
    getFallbackCover,
    getPosterRatioClass,
    getResolvedCover,
} from "@/lib/poster-display";

export async function getStaticPaths() {
    const entries = await getCollection(
        "feeds",
        ({ data }) => data.reviewed === true,
    );
    return entries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const category = getCategoryMeta(entry.data.category);
const fallbackCover = getFallbackCover(
    entry.data.category,
    entry.data.fallbackCover,
);
const cover = getResolvedCover(
    entry.data.category,
    entry.data.cover,
    entry.data.coverStatus,
    entry.data.fallbackCover,
);
const posterRatioClass = getPosterRatioClass(
    entry.data.category,
    entry.data.kind,
);
const title = getDisplayTitle(entry.data.title, entry.data.source);
const subtitle = getDisplaySubtitle(entry.data.subtitle, entry.data.source, [
    title,
]);
const summary = getDisplaySummary(
    entry.data.summary,
    title,
    entry.data.source,
    [subtitle],
);
const metaSummary = summary || subtitle;
---

<BaseLayout
    title={`${title}｜Feeds Hub`}
    description={metaSummary || title}
>
    <article
        class={`content-panel feed-detail category-${entry.data.category} ${posterRatioClass}`}
    >
        <div class="detail-cover">
            <img
                src={cover}
                alt=""
                onerror={`this.onerror=null;this.src='${fallbackCover}';`}
            />
            <a class="category-chip" href={`/category/${category.id}/`}
                >{category.shortName}</a
            >
        </div>
        <div class="detail-body">
            <h1>{title}</h1>
            <div class="markdown-body">
                <FeedMarkdownBody
                    body={entry.body}
                    source={entry.data.source}
                    title={title}
                    subtitle={subtitle}
                    summary={summary}
                />
            </div>
            <p class="source-line">
                <span class="source-meta">
                    来源：
                    {
                        entry.data.sourceUrl ? (
                            <a
                                href={entry.data.sourceUrl}
                                target="_blank"
                                rel="noreferrer"
                            >
                                <span>{entry.data.source ?? "查看原文"}</span>
                                <svg
                                    aria-hidden="true"
                                    viewBox="0 0 24 24"
                                    width="12"
                                    height="12"
                                >
                                    <path d="M7 17L17 7" />
                                    <path d="M9 7h8v8" />
                                </svg>
                            </a>
                        ) : (
                            <span>{entry.data.source ?? "查看原文"}</span>
                        )
                    }
                </span>

                <time datetime={entry.data.eventAt.toISOString()}
                    >{formatDate(entry.data.eventAt)}</time
                >
            </p>
        </div>
    </article>
</BaseLayout>

<style>
    .feed-detail {
        --accent: var(--primary);
        width: min(100%, 820px);
        margin: 8px auto 0;
        overflow: hidden;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.96);
    }

    .feed-detail.category-worldcup {
        --accent: var(--primary);
    }

    .feed-detail.category-lol {
        --accent: #7c3aed;
    }

    .feed-detail.category-stock {
        --accent: var(--signal);
    }

    .feed-detail.category-ai {
        --accent: #0569ed;
    }

    .feed-detail.category-compute {
        --accent: #0891b2;
    }

    .feed-detail.category-global {
        --accent: #0f8b8d;
    }

    .feed-detail.category-rust {
        --accent: #b45309;
    }

    .feed-detail.category-dev {
        --accent: #2563eb;
    }

    .feed-detail.category-security {
        --accent: #475569;
    }

    .feed-detail.category-product {
        --accent: #db2777;
    }

    .detail-cover {
        position: relative;
        width: 100%;
        overflow: hidden;
        border-radius: 16px 16px 0 0;
        background: #0f172a;
    }

    .detail-cover img {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        object-fit: cover;
    }
    .poster-ratio-4x5 .detail-cover img {
        aspect-ratio: 4 / 5;
    }
    .detail-cover .category-chip {
        position: absolute;
        top: 16px;
        right: 16px;
        z-index: 2;
        max-width: calc(100% - 32px);
        overflow: hidden;
        border-radius: 999px;
        padding: 4px 8px;
        color: var(--accent);
        background: rgba(0, 0, 0, 0.8);
        font-size: 13px;
        font-weight: 950;
        letter-spacing: 0;
        line-height: 1.2;
        text-shadow: 0 1px 8px rgba(0, 0, 0, 0.55);
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .detail-cover .category-chip::before {
        content: "";
        display: inline-block;
        width: 8px;
        height: 8px;
        margin-right: 8px;
        border-radius: 999px;
        background: currentColor;
        vertical-align: 1px;
    }
    .detail-body {
        padding: 24px 24px 16px;
    }
    h1 {
        max-width: 760px;
        margin-bottom: 16px;
        font-size: clamp(30px, 5vw, 50px);
        line-height: 1.08;
        letter-spacing: 0;
    }
    .markdown-body {
        margin-top: 16px;
        line-height: 1.8;
    }
    .markdown-body :global(p) {
        margin: 0 0 16px;
    }
    .markdown-body :global(p:last-child) {
        margin-bottom: 8px;
    }
    .markdown-body :global(h2) {
        margin: 24px 0 8px;
        font-size: 22px;
        line-height: 1.28;
        letter-spacing: 0;
    }
    .markdown-body :global(h3) {
        margin: 16px 0 8px;
        font-size: 18px;
        line-height: 1.35;
        letter-spacing: 0;
    }
    .markdown-body :global(ul) {
        margin: 8px 0 16px;
        padding-left: 1.25rem;
    }
    .markdown-body :global(li) {
        margin: 4px 0;
    }
    .markdown-body :global(code) {
        border-radius: 6px;
        padding: 2px 4px;
        background: #eef2f7;
        font-family: var(--mono);
        font-size: 0.92em;
    }
    .markdown-body :global(strong) {
        font-weight: 850;
    }
    .markdown-body :global(a),
    .source-line a {
        color: var(--primary-strong);
        text-decoration: underline;
        text-underline-offset: 3px;
    }
    .source-line a {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        text-decoration: none;
    }
    .source-line svg {
        flex: 0 0 auto;
        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
        fill: none;
        opacity: 0.72;
    }
    .source-line {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        width: 100%;
        margin: 16px 0 0;
        padding-top: 16px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.5;
    }
    .source-meta {
        min-width: 0;
    }
    .source-line time {
        flex: 0 0 auto;
        margin-left: auto;
        font-family: var(--mono);
        font-size: 12px;
        text-align: right;
        white-space: nowrap;
    }
    :global(main) {
        padding-bottom: 16px;
    }
    @media (max-width: 640px) {
        .feed-detail {
            border-radius: 16px;
        }
        .detail-cover {
            border-radius: 16px 16px 0 0;
        }
        .detail-body {
            padding: 16px 16px 12px;
        }
        h1 {
            margin-bottom: 16px;
        }
        .source-line {
            gap: 8px;
        }
    }
</style>
