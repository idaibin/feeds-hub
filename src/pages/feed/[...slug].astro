---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getDisplaySubtitle, getDisplaySummary } from '@/lib/feed-display';
import { formatDate, getCategoryMeta } from '@/lib/feeds';
import { getFallbackCover, getPosterRatioClass, getResolvedCover } from '@/lib/poster-display';

export async function getStaticPaths() {
  const entries = await getCollection('feeds', ({ data }) => data.reviewed === true);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const category = getCategoryMeta(entry.data.category);
const fallbackCover = getFallbackCover(entry.data.category, entry.data.fallbackCover);
const cover = getResolvedCover(entry.data.category, entry.data.cover, entry.data.coverStatus, entry.data.fallbackCover);
const posterRatioClass = getPosterRatioClass(entry.data.category, entry.data.kind);
const subtitle = getDisplaySubtitle(entry.data.subtitle, entry.data.source);
const summary = getDisplaySummary(entry.data.summary, entry.data.title, entry.data.source);
---
<BaseLayout title={`${entry.data.title}｜Feeds Hub`} description={summary || entry.data.title}>
  <article class={`content-panel feed-detail category-${entry.data.category} ${posterRatioClass}`}>
    <div class="detail-cover">
      <img src={cover} alt="" onerror={`this.onerror=null;this.src='${fallbackCover}';`} />
      <a class="category-chip" href={`/category/${category.id}/`}>{category.shortName}</a>
    </div>
    <div class="detail-body">
      <h1>{entry.data.title}</h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}
      {summary && <p class="summary">{summary}</p>}
      <div class="markdown-body"><Content /></div>
      <p class="source-line">
        <time datetime={entry.data.eventAt.toISOString()}>{formatDate(entry.data.eventAt)}</time>
        {entry.data.sourceUrl && <> · 来源：<a href={entry.data.sourceUrl} target="_blank" rel="noreferrer">{entry.data.source ?? '查看原文'}</a></>}
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .feed-detail {
    --accent: var(--primary);
    width: min(100%, 820px);
    margin: 10px auto 0;
    overflow: hidden;
    border-radius: 22px;
    background: rgba(255, 255, 255, .96);
  }

  .feed-detail.category-worldcup {
    --accent: var(--primary);
  }

  .feed-detail.category-lol {
    --accent: #7c3aed;
  }

  .feed-detail.category-stock {
    --accent: var(--signal);
  }

  .feed-detail.category-ai {
    --accent: #0569ed;
  }

  .feed-detail.category-compute {
    --accent: #0891b2;
  }

  .feed-detail.category-global {
    --accent: #0f8b8d;
  }

  .feed-detail.category-rust {
    --accent: #b45309;
  }

  .feed-detail.category-dev {
    --accent: #2563eb;
  }

  .feed-detail.category-security {
    --accent: #475569;
  }

  .feed-detail.category-product {
    --accent: #db2777;
  }

  .detail-cover {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 22px 22px 0 0;
    background: #0f172a;
  }

  .detail-cover img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    object-fit: cover;
  }
  .poster-ratio-4x5 .detail-cover img { aspect-ratio: 4 / 5; }
  .detail-cover .category-chip {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 2;
    max-width: calc(100% - 32px);
    overflow: hidden;
    border-radius: 999px;
    padding: 6px 10px;
    color: var(--accent);
    background: rgba(0, 0, 0, .8);
    font-size: 13px;
    font-weight: 950;
    letter-spacing: 0;
    line-height: 1.2;
    text-shadow: 0 1px 8px rgba(0, 0, 0, .55);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .detail-cover .category-chip::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    border-radius: 999px;
    background: currentColor;
    vertical-align: 1px;
  }
  .detail-body {
    padding: clamp(22px, 4vw, 38px) clamp(22px, 4vw, 42px) clamp(16px, 3vw, 24px);
  }
  h1 { max-width: 760px; margin-bottom: 16px; font-size: clamp(30px, 5vw, 50px); line-height: 1.08; letter-spacing: 0; }
  .subtitle { max-width: 760px; font-size: 20px; color: var(--muted-strong); font-weight: 820; }
  .summary { padding: 16px 18px; border-radius: 14px; border: 1px solid var(--border); background: #f8fafc; color: var(--muted-strong); }
  .markdown-body { margin-top: 24px; line-height: 1.8; }
  .markdown-body :global(a), .source-line a { color: var(--primary-strong); text-decoration: underline; text-underline-offset: 3px; }
  .source-line { margin: 20px 0 0; font-size: 14px; }
  .source-line time { font-family: var(--mono); font-size: 12px; }
  @media (max-width: 640px) {
    .feed-detail { border-radius: 24px; }
    .detail-cover { border-radius: 24px 24px 0 0; }
  }
</style>
