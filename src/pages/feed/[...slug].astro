---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, getCategoryMeta } from '@/lib/feeds';

export async function getStaticPaths() {
  const entries = await getCollection('feeds', ({ data }) => data.reviewed === true);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const category = getCategoryMeta(entry.data.category);
---
<BaseLayout title={`${entry.data.title}｜Feeds Hub`} description={entry.data.summary}>
  <article class="content-panel feed-detail">
    <div class="detail-cover"><img src={entry.data.cover} alt={`${entry.data.title}海报`} /></div>
    <div class="detail-body">
      <div class="meta-line"><a href={`/category/${category.id}/`}>{category.name}</a><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time></div>
      <h1>{entry.data.title}</h1>
      <p class="subtitle">{entry.data.subtitle}</p>
      <p class="summary">{entry.data.summary}</p>
      <div class="markdown-body"><Content /></div>
      {entry.data.sourceUrl && <p class="source-line">来源：<a href={entry.data.sourceUrl} target="_blank" rel="noreferrer">{entry.data.source ?? '查看原文'}</a></p>}
    </div>
  </article>
</BaseLayout>

<style>
  .feed-detail { overflow: hidden; }
  .detail-cover { aspect-ratio: 16 / 9; background: #eef4ff; }
  .detail-cover img { width: 100%; height: 100%; object-fit: cover; }
  .detail-body { padding: clamp(22px, 4vw, 42px); }
  .meta-line { display: flex; justify-content: space-between; gap: 16px; color: var(--muted); margin-bottom: 18px; }
  .meta-line a { color: #1d4ed8; font-weight: 800; }
  .subtitle { font-size: 20px; color: #334155; }
  .summary { padding: 16px 18px; border-radius: 18px; background: #f8fafc; color: #334155; }
  .markdown-body { margin-top: 28px; line-height: 1.85; }
  .markdown-body :global(a), .source-line a { color: #1d4ed8; text-decoration: underline; text-underline-offset: 3px; }
  .source-line { margin-top: 28px; font-size: 14px; }
  @media (max-width: 640px) { .meta-line { flex-direction: column; } }
</style>
