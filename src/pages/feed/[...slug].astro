---
import BaseLayout from "@/components/BaseLayout.astro";
import FeedCard from "@/components/FeedCard.astro";
import { getFeedSource } from "@/lib/feed-sources";
import {
    getDisplaySubtitle,
    getDisplaySummary,
    getDisplayTitle,
} from "@/lib/feed-display";

export const prerender = false;

const slug = Astro.params.slug ?? "";
if (!/^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?(?:\/[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?)*$/.test(slug)) {
    return new Response(null, { status: 404, statusText: "Not found" });
}
const feed = await (await getFeedSource()).getBySlug(slug);
if (!feed) return new Response(null, { status: 404, statusText: "Not found" });
const title = getDisplayTitle(feed.title, feed.source);
const subtitle = getDisplaySubtitle(feed.subtitle, feed.source, [
    title,
]);
const summary = getDisplaySummary(
    feed.summary,
    title,
    feed.source,
    [subtitle],
);
const metaSummary = summary || subtitle;
---

<BaseLayout title={`${title}｜Feeds Hub`} description={metaSummary || title}>
    <FeedCard feed={feed} mode="detail" />
</BaseLayout>
