---
import FeedList from '@/components/FeedList.astro';
import BaseLayout from '@/components/BaseLayout.astro';
import { getAllFeeds } from '@/lib/feeds';

const feeds = await getAllFeeds();
---
<BaseLayout title="Feeds Hub" description="全部中文资讯聚合。" hideFooter>
  <FeedList entries={feeds} ariaLabel="全部信息" listId="all" />
</BaseLayout>
