---
import FeedCard from '@/components/FeedCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllFeeds } from '@/lib/feeds';
const feeds = await getAllFeeds();
---
<BaseLayout title="Feeds Hub｜中文信息流" description="中文主题信息流聚合站。">
  <section class="hero">
    <div class="hero-panel">
      <span class="eyebrow">中文信息流 · 每小时同步</span>
      <h1>把重点信息变成可阅读、可分享的卡片。</h1>
      <p>默认关注世界杯、LOL、市场简报和 AI 科技。内容通过基础审查后展示。</p>
    </div>
    <aside class="summary-panel">
      <span class="summary-number">{feeds.length}</span>
      <strong>已展示内容</strong>
      <p>按发布时间倒序排列。</p>
    </aside>
  </section>
  <section class="category-list">
    <a class="category-card" href="/category/worldcup/"><strong>世界杯</strong><span>默认关注 2026 世界杯。</span></a>
    <a class="category-card" href="/category/lol/"><strong>LOL 赛事</strong><span>关注 LPL、MSI 和世界赛。</span></a>
    <a class="category-card" href="/category/stock/"><strong>股市简报</strong><span>关注 A 股和美股。</span></a>
    <a class="category-card" href="/category/ai/"><strong>AI 科技</strong><span>关注模型、产品和工程工具。</span></a>
  </section>
  <section>
    <div class="section-head"><div><h2>最新信息流</h2><p>图片、标题、副标题和摘要优先。</p></div></div>
    {feeds.length > 0 ? <div class="feed-grid">{feeds.map((entry) => <FeedCard entry={entry} />)}</div> : <div class="empty-state">暂无已审查内容。</div>}
  </section>
</BaseLayout>
