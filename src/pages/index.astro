---
import FeedCard from '@/components/FeedCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllFeeds } from '@/lib/feeds';

const feeds = await getAllFeeds();
---
<BaseLayout title="Feeds Hub" description="全部中文主题信息流。">
  {feeds.length > 0 ? <div class="masonry-feed">{feeds.map((entry) => <FeedCard entry={entry} />)}</div> : <div class="empty-state">暂无内容。</div>}
</BaseLayout>
