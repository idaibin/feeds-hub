---
import FeedList from '@/components/FeedList.astro';
import BaseLayout from '@/components/BaseLayout.astro';
import { getFeedSource } from '@/lib/feed-sources';

export const prerender = false;

const page = await (await getFeedSource()).listPublished({ list: 'all', page: 1, pageSize: 10 });
---
<BaseLayout title="Feeds Hub" description="全部中文资讯聚合。" hideFooter>
  <FeedList entries={page.items} ariaLabel="全部信息" listId="all" hasMore={page.hasMore} />
</BaseLayout>
